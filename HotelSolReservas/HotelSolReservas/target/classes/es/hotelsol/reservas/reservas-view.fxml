<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="es.hotelsol.reservas.ReservasController" styleClass="root-pane">
    <top>
        <VBox spacing="5" styleClass="header">
            <padding><Insets top="22" right="28" bottom="20" left="28"/></padding>
            <Label text="HOTEL SOL" styleClass="eyebrow"/>
            <Label text="Gestión de habitaciones" styleClass="page-title"/>
            <Label fx:id="hotelSubtitle" text="Cargando datos del hotel..." styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="18">
            <padding><Insets top="20" right="28" bottom="24" left="28"/></padding>
            <HBox spacing="12" styleClass="stats-row">
                <VBox spacing="5" styleClass="stat-card">
                    <Label text="TOTAL HABITACIONES" styleClass="stat-label"/>
                    <Label fx:id="totalHabitaciones" text="0" styleClass="stat-number"/>
                </VBox>
                <VBox spacing="5" styleClass="stat-card">
                    <Label text="DISPONIBLES" styleClass="stat-label"/>
                    <Label fx:id="totalDisponibles" text="0" styleClass="stat-number green-text"/>
                </VBox>
                <VBox spacing="5" styleClass="stat-card">
                    <Label text="OCUPADAS" styleClass="stat-label"/>
                    <Label fx:id="totalOcupadas" text="0" styleClass="stat-number red-text"/>
                </VBox>
                <VBox spacing="5" styleClass="stat-card">
                    <Label text="MANTENIMIENTO" styleClass="stat-label"/>
                    <Label fx:id="totalMantenimiento" text="0" styleClass="stat-number amber-text"/>
                </VBox>
            </HBox>

            <VBox spacing="10" styleClass="search-panel">
                <Label text="Consultar habitación" styleClass="section-title"/>
                <Label text="Introduce el número para comprobar si existe y conocer su estado." styleClass="help-text"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="campoBusqueda" promptText="Ej. 111" onAction="#buscarHabitacion"
                               HBox.hgrow="ALWAYS" styleClass="search-input"/>
                    <Button text="Buscar" onAction="#buscarHabitacion" styleClass="primary-button"/>
                    <Button text="Limpiar" onAction="#limpiarBusqueda" styleClass="secondary-button"/>
                </HBox>
                <HBox fx:id="tarjetaResultado" spacing="14" alignment="CENTER_LEFT"
                      styleClass="result-card result-neutral">
                    <VBox spacing="4" minWidth="135">
                        <Label fx:id="numeroResultado" text="—" styleClass="result-number"/>
                        <Label fx:id="estadoResultado" text="Sin consultar" styleClass="result-status"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="resultadoBusqueda" text="Busca una habitación por su número" styleClass="result-heading"/>
                        <Label fx:id="detalleResultado" text="El estado y los detalles de la habitación aparecerán aquí."
                               wrapText="true" styleClass="result-detail"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Listado de habitaciones" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="filtroEstado" prefWidth="190" promptText="Filtrar por estado"/>
                </HBox>
                <TableView fx:id="tablaHabitaciones" VBox.vgrow="ALWAYS" minHeight="220">
                    <columns>
                        <TableColumn fx:id="colNumero" text="N.º" prefWidth="65"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="105"/>
                        <TableColumn fx:id="colPlanta" text="Planta" prefWidth="65"/>
                        <TableColumn fx:id="colCapacidad" text="Capacidad" prefWidth="85"/>
                        <TableColumn fx:id="colPrecio" text="Precio/noche" prefWidth="105"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="115"/>
                        <TableColumn fx:id="colVista" text="Vista" prefWidth="150"/>
                        <TableColumn fx:id="colAccesible" text="Accesible" prefWidth="85"/>
                    </columns>
                    <placeholder><Label text="No hay habitaciones que coincidan con el filtro."/></placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
